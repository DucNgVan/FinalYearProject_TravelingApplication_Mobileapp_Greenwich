# Server Configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nomadix_dev
PG_USER=nomadix
PG_PASSWORD=nomadix_secret
DATABASE_URL=postgresql://nomadix:nomadix_secret@localhost:5432/nomadix_dev

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nomadix_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=nomadix_super_secret_access_token_key_2026_dev
JWT_REFRESH_SECRET=nomadix_super_secret_refresh_token_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=nomadix_dev
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# Duffel Travel API (Flights & Stays)
DUFFEL_API_TOKEN=duffel_test_your_token_here

# Google Maps / Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Mapbox GL & Foursquare Places (Global Map Discovery)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
FOURSQUARE_API_KEY=your_foursquare_api_key_here
