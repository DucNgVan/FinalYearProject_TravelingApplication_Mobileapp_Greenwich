{
  "name": "nomadix-server",
  "version": "1.0.0",
  "description": "Nomadix Modular Monolith API Gateway & Services",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "migrate:latest": "node -e \"require('./src/db/migrator').up().then(r => console.log('Applied:', r)).catch(e => { console.error(e); process.exit(1); })\"",
    "migrate:rollback": "node -e \"require('./src/db/migrator').down().then(r => console.log('Reverted:', r)).catch(e => { console.error(e); process.exit(1); })\"",
    "migrate:status": "node -e \"require('./src/db/migrator').status().then(s => console.log('Status:', s)).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "mongoose": "^8.6.0",
    "pg": "^8.12.0",
    "winston": "^3.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
