  "cards": [
    {
      "dot": "cyan",
      "title": "PostgreSQL 16 Financial Integrity",
      "items": [
        "All ledger balances use NUMERIC(12,2) with ACID transactions",
        "Strict foreign key constraints ensure non-dangling debt splits"
      ]
    },
    {
      "dot": "emerald",
      "title": "MongoDB Atlas 7.0 Timeline Polymorphism",
      "items": [
        "Multi-day stops, collaborators, and transit are embedded in 1 document",
        "Sub-15ms reads without relational multi-table JOIN overhead"
      ]
    }
  ]
